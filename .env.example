# Environment variables for AI OCR Module

# LLM API key for document parsing (optional)
# Set this to enable the /ocr endpoint with parse_doc=true
# OPENAI_API_KEY=sk-your-key-here

# Optional: Use a custom OpenAI-compatible endpoint (e.g., local LLM)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Alternative env var names (take precedence)
# OCR_LLM_API_KEY=
# OCR_LLM_BASE_URL=

# Model id used for parsing. Must match what your provider expects.
# OCR_LLM_MODEL=gpt-4o-mini

# ---- OpenRouter example ---------------------------------------------------
# OpenRouter is OpenAI-compatible: point base_url at it and use a namespaced
# model id. Create a key at https://openrouter.ai/keys
# OCR_LLM_API_KEY=sk-or-v1-your-key-here
# OCR_LLM_BASE_URL=https://openrouter.ai/api/v1
# Model id: any namespaced OpenRouter model works. A reliable low-cost pick:
# OCR_LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# (others: openai/gpt-4o-mini; ids ending in :free are rate-limited by a shared pool)
# Optional attribution headers OpenRouter uses for ranking/analytics:
# OCR_LLM_TITLE=AI OCR Service
# OCR_LLM_REFERER=https://your-domain.example

# ---- Local / self-hosted LLM example (Ollama, LM Studio, llama.cpp, vLLM) --
# These expose an OpenAI-compatible endpoint.
# Ollama (no auth by default):
#   ollama pull qwen2.5:7b-instruct
#   OCR_LLM_BASE_URL=http://localhost:11434/v1
#   OCR_LLM_MODEL=qwen2.5:7b-instruct
#   OCR_LLM_API_KEY=            (Ollama ignores the key; leave empty)
# LM Studio: its server has an optional "API Key" toggle. If enabled, put that
#   key in OCR_LLM_API_KEY (sent as Authorization: Bearer). If disabled, leave empty.
#   OCR_LLM_BASE_URL=http://localhost:1234/v1
#   OCR_LLM_MODEL=llama-3.1-8b-instruct   (the id shown in LM Studio's model list)
#   OCR_LLM_API_KEY=your-lmstudio-key      (only if the API-key toggle is on)
# Loopback hosts (localhost/127.0.0.1/host.docker.internal/*.local) are allowed
# keylessly automatically when no key is set. For a trusted private-LAN server,
# opt in with: OCR_LLM_KEYLESS=true
# Running in Docker? Point it at the host server (compose maps host.docker.internal):
# OCR_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Output token budget for parsing. Reasoning/thinking models (e.g. deepseek
# variants) spend tokens on hidden reasoning before the answer; if this is too
# small they return empty content and parsing yields null. Default 4000; raise
# to 8000+ for long multi-page documents.
# OCR_LLM_MAX_TOKENS=8000

# Max characters of OCR text sent to the LLM. Above this, the middle is trimmed
# while the document head and tail are preserved (totals/summaries usually sit
# at the end). Default 40000. Raise for very large documents.
# OCR_LLM_MAX_INPUT_CHARS=40000

# ---------------------------------------------------------------------------
# Authentication (required for SaaS / public deployments)
# ---------------------------------------------------------------------------

# Admin accounts sign in to /admin with an email + password over a secure,
# server-side session cookie (no third-party deps; PBKDF2-HMAC-SHA256).
# The first admin is seeded on startup when the admins table is empty:
#   - If both OCR_ADMIN_EMAIL and OCR_ADMIN_PASSWORD are set, that account is
#     created (use strong values in production).
#   - Otherwise a dev admin "admin@localhost" is created with a random password
#     printed to the server log.
# After the first admin exists, add/remove admins from the Admin portal.
# OCR_ADMIN_EMAIL=admin@example.com
# OCR_ADMIN_PASSWORD=change-me-please

# Legacy static admin token. Optional now: still accepted on /admin/* for
# headless/API automation (X-Admin-Token header) as a backward-compat fallback.
# If unset, admin access is purely session-cookie based. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OCR_ADMIN_TOKEN=

# Session cookie & lifetime (revocable server-side sessions stored in auth.db).
# Cookie name sent to browsers (HttpOnly, SameSite=Lax).
# OCR_SESSION_COOKIE=ocr_session
# Admin session lifetime in hours. Default 12.
# OCR_ADMIN_SESSION_TTL_HOURS=12
# Client session lifetime in days. Default 7.
# OCR_CLIENT_SESSION_TTL_DAYS=7
# Set to true when serving behind HTTPS so the cookie is TLS-only (Secure).
# OCR_COOKIE_SECURE=false

# Public self-signup throttle (signups per minute, per process). Default 10.
# OCR_SIGNUP_RATE_PER_MIN=10

# Optional: seed a first client API key automatically on startup. Useful for
# bootstrapping. The same key can also be created via POST /admin/keys.
# OCR_BOOTSTRAP_API_KEY=ocr_your_generated_key

# Where the hashed API-key store lives. Defaults to ./auth.db in the project
# root. This file is git-ignored; back it up like any production database.
# OCR_AUTH_DB=/var/lib/aiocr/auth.db

# Maximum accepted upload size in bytes. Default is 10 MB (10485760).
# OCR_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Quotas & rate limits (applied to NEW keys created via the admin portal)
# ---------------------------------------------------------------------------
# These are defaults stamped onto a client key at creation when the admin does
# not set them explicitly. Leave unset for unlimited. Existing keys are only
# affected if you edit them under Admin > Limits. The seeded bootstrap key is
# always unlimited.

# Default plan label for new keys (e.g. "free", "starter").
# OCR_DEFAULT_PLAN=

# Default monthly OCR request cap for new keys (calendar month). Unlimited if unset.
# OCR_DEFAULT_MONTHLY_QUOTA=1000

# Default per-minute rate limit for new keys (rolling window). Unlimited if unset.
# NOTE: rate limiting is per-process; run a single uvicorn worker for it to be
# exact. Cross-worker limits would require Redis.
# OCR_DEFAULT_RPM_LIMIT=60

# What happens to a NEW key when its monthly quota is exhausted:
#   hard (default) -> further requests are rejected with HTTP 429
#   soft           -> requests keep being served but flagged (X-Over-Quota header)
# Admins can still override this per client in the Admin portal.
# OCR_DEFAULT_OVER_LIMIT_MODE=hard
